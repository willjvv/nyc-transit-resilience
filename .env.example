# Copy this file to .env and fill in real values. Never commit .env itself.

# MTA API key, register free at https://api.mta.info/
# Most GTFS-RT endpoints work without one, but set it if you have it -
# poll_feeds.py will send it as the x-api-key header when present.
MTA_API_KEY=

# Local paths for the data lake. Defaults match the repo's data/ folder,
# only change these if you're pointing at external storage.
RAW_DATA_DIR=data/raw
PROCESSED_DATA_DIR=data/processed
STATIC_GTFS_DIR=data/static_gtfs

# Optional: Cloudflare R2 / Backblaze B2 credentials, only needed if you
# want raw snapshots written off-box instead of to local disk. Leave
# blank to use local disk only.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# How often poll_feeds.py polls each feed, in seconds
POLL_INTERVAL_SECONDS=45
